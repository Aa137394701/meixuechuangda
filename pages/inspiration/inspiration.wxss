page {
  background: linear-gradient(180deg, #FFF8F0 0%, #FFFBF5 100%);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.inspiration-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* 日期区域 */
.date-section {
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #FFF8F0 0%, #FFFBF5 100%);
}

.date-main {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
}

.day {
  font-size: 120rpx;
  font-weight: 700;
  color: #8B7355;
  line-height: 1;
  font-family: 'Georgia', serif;
}

.date-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.date-text {
  font-size: 28rpx;
  color: #A09078;
  font-weight: 500;
}

.lunar-text {
  font-size: 32rpx;
  color: #8B7355;
  font-weight: 600;
  letter-spacing: 2rpx;
}
