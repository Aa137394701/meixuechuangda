<view class="container">
  <!-- 顶部装饰背景 -->
  <view class="top-glow"></view>

  <!-- 内容区 -->
  <view class="content">
    <!-- 日期信息 -->
    <view class="date-section">
      <view class="date-main">
        <text class="day">{{currentDay}}</text>
        <view class="date-info">
          <text class="date-text">{{formattedDate}}</text>
          <text class="lunar-text">{{lunarDate}}</text>
        </view>
      </view>
    </view>

    <!-- 今日穿搭指南 -->
    <view class="zodiac-section">
      <view class="section-title">
        <text class="section-number">02</text>
        <text class="section-name">今日穿搭指南</text>
      </view>

      <view class="zodiac-grid">
        <view class="zodiac-item" wx:for="{{zodiacList}}" wx:key="name">
          <view class="zodiac-icon">{{item.icon}}</view>
          <view class="zodiac-info">
            <text class="zodiac-colors">{{item.colors}}</text>
          </view>
        </view>
      </view>

      <!-- 查看我的色系按钮 -->
      <view class="my-color-action" bindtap="goToMyColor">
        <text class="my-color-text">查看我的今日色系推荐</text>
        <text class="my-color-arrow">›</text>
      </view>
    </view>
  </view>
</view>
