page {
  background-color: #F8FAFC;
  font-family: -apple-system, "SF Pro Display", "PingFang SC", sans-serif;
}

.container {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #EBF0FF 0%, #F8FAFC 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: 20rpx;
}

.top-glow {
  position: absolute;
  top: -150rpx;
  left: -50rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(46, 88, 235, 0.12) 0%, rgba(255,255,255,0) 70%);
  z-index: 0;
}

.content {
  flex: 1;
  padding: 24rpx;
  padding-bottom: 120rpx;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.date-section {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(46, 88, 235, 0.06);
}

.date-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.day {
  font-size: 72rpx;
  font-weight: 800;
  color: #2E58EB;
  line-height: 1;
}

.date-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.date-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
}

.lunar-text {
  font-size: 24rpx;
  color: #64748B;
}

/* 今日穿搭指南 */
.zodiac-section {
  padding: 32rpx;
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(46, 88, 235, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-number {
  display: inline-block;
  background: linear-gradient(135deg, #2E58EB 0%, #1E40AF 100%);
  color: white;
  font-size: 24rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.section-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
}

.zodiac-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.zodiac-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #F8FAFC 0%, #EBF0FF 100%);
  border-radius: 16rpx;
  border: 1rpx solid rgba(46, 88, 235, 0.1);
}

.zodiac-icon {
  font-size: 64rpx;
  line-height: 1;
}

.zodiac-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.zodiac-colors {
  font-size: 26rpx;
  color: #475569;
  font-weight: 600;
}

/* 我的色系按钮 */
.my-color-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 32rpx;
  margin-top: 24rpx;
  background: linear-gradient(135deg, rgba(46, 88, 235, 0.1) 0%, rgba(30, 64, 175, 0.1) 100%);
  border: 2rpx solid rgba(46, 88, 235, 0.3);
  border-radius: 24rpx;
  animation: pulse 2s infinite;
  cursor: pointer;
}

.my-color-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #2E58EB;
}

.my-color-arrow {
  font-size: 40rpx;
  color: #2E58EB;
  line-height: 1;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 6rpx 16rpx rgba(46, 88, 235, 0.35);
  }
  50% {
    transform: scale(1.08);
    box-shadow: 0 8rpx 20rpx rgba(46, 88, 235, 0.45);
  }
}
