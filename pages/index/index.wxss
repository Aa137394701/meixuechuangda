/* 五行美学指南 - Bento Grid 风格重构版 */

page {
  background-color: #F8FAFC;
  font-family: -apple-system, "SF Pro Display", "PingFang SC", sans-serif;
}

.container {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #EBF0FF 0%, #F8FAFC 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: 20rpx;
}

/* 顶部装饰背景 */
.top-glow {
  position: absolute;
  top: -150rpx;
  left: -50rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(46, 88, 235, 0.12) 0%, rgba(255,255,255,0) 70%);
  z-index: 0;
}



.back-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  cursor: pointer;
}

.back-icon {
  font-size: 28rpx;
  color: #2E58EB;
  font-weight: bold;
}

.back-text {
  font-size: 24rpx;
  color: #475569;
  font-weight: 500;
}

/* 内容区 - Bento Grid 布局 */
.content {
  flex: 1;
  padding: 24rpx;
  padding-bottom: 120rpx; /* 增加底部内边距，避免内容被 TabBar 遮挡 */
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 20rpx; /* 增加卡片间距 */
}

/* 返回按钮 */
.back-btn-wrapper {
  margin-bottom: 16rpx;
}

.back-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.back-icon {
  font-size: 28rpx;
  color: #2E58EB;
  font-weight: bold;
}

.back-text {
  font-size: 24rpx;
  color: #475569;
  font-weight: 500;
}

/* Bento Card 基础样式 - 12px 圆角毛玻璃 */
.bento-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(46, 88, 235, 0.06);
}

/* 卡片头部 */
.card-header {
  margin-bottom: 8rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E293B;
  display: block;
}

.card-desc {
  font-size: 24rpx;
  color: #64748B;
  display: block;
  margin-top: 8rpx;
}

/* 输入卡片 */
.input-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.input-box {
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid #E2E8F0;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.placeholder-text {
  color: #64748B;
  font-size: 30rpx;
}

.arrow-icon {
  color: #2E58EB;
  font-weight: bold;
  font-size: 40rpx;
}

/* 主按钮 */
.main-btn {
  margin: 24rpx 24rpx 120rpx;
  background: linear-gradient(135deg, #2E58EB 0%, #1A44D1 100%);
  color: white;
  border: none;
  width: calc(100% - 48rpx);
  padding: 28rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 40rpx rgba(46, 88, 235, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.main-btn:active {
  transform: scale(0.98);
}

.sparkle {
  font-size: 40rpx;
}

.regenerate-btn {
  background: linear-gradient(135deg, #2E58EB 0%, #1A44D1 100%);
}

.view-color-btn {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF3B30 100%);
}

/* 雷达图区域 */
.radar-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.radar-section {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 10rpx 0;
  width: 100%;
}

.radar-summary {
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.6;
  text-align: center;
  padding: 8rpx 16rpx;
  background: rgba(46, 88, 235, 0.04);
  border-radius: 12rpx;
}

/* 主色调卡片 */
.primary-color-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 24rpx;
}

.primary-label {
  font-size: 24rpx;
  color: #64748B;
  font-weight: 500;
}

.primary-color-display {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.color-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.color-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E293B;
}

.date-display {
  font-size: 22rpx;
  color: #94A3B8;
}

/* 色彩推荐色块卡片 */
.color-palette-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.color-palette-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx;
  background: rgba(46, 88, 235, 0.02);
  border-radius: 16rpx;
}

.palette-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.palette-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
  overflow: hidden;
  position: relative;
}

.palette-icon .css-tshirt {
  width: 32rpx;
  height: 32rpx;
  position: relative;
  z-index: 1;
}

.palette-icon .css-tshirt .tshirt-body {
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 16rpx;
  border: 2.5rpx solid white;
  border-radius: 3rpx;
  box-sizing: border-box;
}

.palette-icon .css-tshirt .tshirt-collar {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 10rpx;
  height: 7rpx;
  border: 2.5rpx solid white;
  border-bottom: none;
  border-radius: 5rpx 5rpx 0 0;
  box-sizing: border-box;
}

.palette-icon .css-tshirt .tshirt-sleeve-l {
  position: absolute;
  top: 10rpx;
  left: 2rpx;
  width: 8rpx;
  height: 10rpx;
  border: 2.5rpx solid white;
  border-right: none;
  border-radius: 3rpx 0 0 3rpx;
  box-sizing: border-box;
}

.palette-icon .css-tshirt .tshirt-sleeve-r {
  position: absolute;
  top: 10rpx;
  right: 2rpx;
  width: 8rpx;
  height: 10rpx;
  border: 2.5rpx solid white;
  border-left: none;
  border-radius: 0 3rpx 3rpx 0;
  box-sizing: border-box;
}

.palette-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1E293B;
}

.palette-colors {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-left: 68rpx;
}

.color-block {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

.palette-desc {
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.5;
}

/* 关键词卡片 */
.keywords-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 风格建议卡片 */
.style-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 香氛建议卡片 */
.fragrance-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 解析卡片 */
.analysis-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.analysis-content {
  padding: 8rpx 0;
}

.analysis-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: #475569;
  display: block;
}

/* 日期信息 */
.date-section {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(46, 88, 235, 0.06);
}

.date-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.day {
  font-size: 72rpx;
  font-weight: 800;
  color: #2E58EB;
  line-height: 1;
}

.date-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.date-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
}

.lunar-text {
  font-size: 24rpx;
  color: #64748B;
}

/* 标签组 */
.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.tag {
  padding: 12rpx 20rpx;
  background: #F1F5F9;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #475569;
  border: 1rpx solid #E2E8F0;
  font-weight: 500;
}

/* 建议文本 */
.advice-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #475569;
  display: block;
  margin-top: 8rpx;
}

/* 禁用状态 */
.main-btn[disabled] {
  opacity: 0.6;
}

/* 节段编号 */
.section-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #2E58EB 0%, #1A44D1 100%);
  color: white;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 12rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
  display: flex;
  align-items: center;
}
