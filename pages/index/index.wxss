page {
  background-color: #F8FAFC;
  font-family: -apple-system, "SF Pro Display", "PingFang SC", sans-serif;
}

.container {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #EBF0FF 0%, #F8FAFC 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: 20rpx;
}

.top-glow {
  position: absolute;
  top: -150rpx;
  left: -50rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(46, 88, 235, 0.12) 0%, rgba(255,255,255,0) 70%);
  z-index: 0;
}

.content {
  flex: 1;
  padding: 24rpx;
  padding-bottom: 120rpx;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.date-section {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(46, 88, 235, 0.06);
}

.date-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.day {
  font-size: 72rpx;
  font-weight: 800;
  color: #2E58EB;
  line-height: 1;
}

.date-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.date-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
}

.lunar-text {
  font-size: 24rpx;
  color: #64748B;
}
