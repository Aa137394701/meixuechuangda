page {
  background-color: #F8FAFC;
  font-family: -apple-system, "SF Pro Display", "PingFang SC", sans-serif;
}

.profile-page {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #EBF0FF 0%, #F8FAFC 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部装饰背景 */
.top-glow {
  position: absolute;
  top: -150rpx;
  left: -50rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(46, 88, 235, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
  z-index: 0;
}

/* 内容区 */
.content {
  flex: 1;
  padding: 24rpx;
  padding-bottom: 120rpx;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* Bento Card 基础样式 */
.bento-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(46, 88, 235, 0.06);
}

/* 卡片头部 */
.card-header {
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E293B;
  display: block;
}

/* 用户信息卡片 */
.user-info-card {
  padding: 32rpx 24rpx;
}

.user-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(46, 88, 235, 0.2);
  box-shadow: 0 8rpx 24rpx rgba(46, 88, 235, 0.12);
}

.user-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #1E293B;
}

.user-status {
  font-size: 24rpx;
  color: #64748B;
}

.login-prompt {
  cursor: pointer;
}

.login-prompt:active {
  opacity: 0.7;
}

/* 美学基因管理卡片 */
.aesthetic-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 设置项 */
.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 16rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 16rpx;
  transition: background 0.2s;
}

.setting-item:active {
  background: rgba(46, 88, 235, 0.05);
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.setting-icon {
  font-size: 36rpx;
}

.setting-label {
  font-size: 28rpx;
  color: #1E293B;
  font-weight: 500;
}

.setting-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.setting-value {
  font-size: 26rpx;
  color: #64748B;
}

.setting-arrow {
  font-size: 32rpx;
  color: #94A3B8;
  font-weight: bold;
}

/* 常规设置卡片 */
.settings-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 退出登录按钮 */
.logout-btn {
  margin: 24rpx 24rpx 120rpx;
  background: rgba(244, 67, 54, 0.1);
  color: #F44336;
  border: 1rpx solid rgba(244, 67, 54, 0.2);
  width: calc(100% - 48rpx);
  padding: 28rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.logout-btn:active {
  transform: scale(0.98);
  background: rgba(244, 67, 54, 0.15);
}
