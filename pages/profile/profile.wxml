<view class="profile-page">
  <!-- 顶部装饰背景 -->
  <view class="top-glow"></view>

  <view class="content">
    <!-- 用户信息区 -->
    <view class="bento-card user-info-card">
      <block wx:if="{{isLoggedIn}}">
        <view class="user-header">
          <image class="user-avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.svg'}}" mode="aspectFill"></image>
          <view class="user-details">
            <text class="user-nickname">{{userInfo.nickName || '用户'}}</text>
            <text class="user-status">已记录美学基因</text>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="login-prompt" bindtap="handleLogin">
          <view class="user-header">
            <image class="user-avatar" src="/images/default-avatar.png" mode="aspectFill"></image>
            <view class="user-details">
              <text class="user-nickname">点击登录</text>
              <text class="user-status">登录后记录美学基因</text>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 美学基因管理板块 -->
    <view class="bento-card aesthetic-card" wx:if="{{isLoggedIn}}">
      <view class="card-header">
        <text class="card-title">美学基因管理</text>
      </view>
      
      <picker mode="date" value="{{userInfo.birthday || '1990-01-01'}}" start="1950-01-01" end="{{maxDate}}" bindchange="onBirthdayChange">
        <view class="setting-item">
          <view class="setting-left">
            <text class="setting-icon"></text>
            <text class="setting-label">修改美学生日</text>
          </view>
          <view class="setting-right">
            <text class="setting-value">{{userInfo.birthday || '未设置'}}</text>
            <text class="setting-arrow">›</text>
          </view>
        </view>
      </picker>
    </view>

    <!-- 常规设置 -->
    <view class="bento-card settings-card">
      <view class="card-header">
        <text class="card-title">常规设置</text>
      </view>
      
      <view class="setting-item" bindtap="handleAbout">
        <view class="setting-left">
          <text class="setting-icon">ℹ️</text>
          <text class="setting-label">关于我们</text>
        </view>
        <view class="setting-right">
          <text class="setting-arrow">›</text>
        </view>
      </view>

      <view class="setting-item" bindtap="handleFeedback">
        <view class="setting-left">
          <text class="setting-icon">💬</text>
          <text class="setting-label">意见反馈</text>
        </view>
        <view class="setting-right">
          <text class="setting-arrow">›</text>
        </view>
      </view>

      <view class="setting-item" bindtap="handleClearCache">
        <view class="setting-left">
          <text class="setting-icon">🗑️</text>
          <text class="setting-label">清除缓存</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">{{cacheSize}}</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 退出登录按钮 -->
    <button class="logout-btn" wx:if="{{isLoggedIn}}" bindtap="handleLogout">
      <text>退出登录</text>
    </button>
  </view>
</view>
