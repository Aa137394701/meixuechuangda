page {
  background: linear-gradient(180deg, #FFF8F0 0%, #FFFBF5 100%);
  min-height: 100vh;
}

.my-color-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: #8B7355;
  font-weight: 500;
}

/* 未登录状态 */
.not-login-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
}

.not-login-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  text-align: center;
}

.not-login-icon {
  font-size: 120rpx;
  margin-bottom: 16rpx;
}

.not-login-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #5C4B3A;
}

.not-login-desc {
  font-size: 28rpx;
  color: #8B7355;
  line-height: 1.6;
  max-width: 600rpx;
}

.go-home-btn {
  margin-top: 32rpx;
  padding: 24rpx 80rpx;
  background: linear-gradient(135deg, #2E58EB 0%, #1E40AF 100%);
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 32rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(46, 88, 235, 0.3);
}

/* 用户信息卡片 */
.result-container {
  padding: 32rpx;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(139, 115, 85, 0.08);
  border: 1rpx solid rgba(221, 196, 143, 0.2);
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(46, 88, 235, 0.2);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #5C4B3A;
}

.user-birthday {
  font-size: 24rpx;
  color: #8B7355;
}

/* 今日主色调卡片 */
.today-wuxing-card {
  padding: 32rpx;
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(139, 115, 85, 0.08);
  border: 1rpx solid rgba(221, 196, 143, 0.2);
  margin-bottom: 24rpx;
  text-align: center;
}

.wuxing-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.wuxing-label {
  font-size: 28rpx;
  color: #8B7355;
}

.wuxing-value {
  font-size: 40rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #D4C4A0 0%, #B8A88A 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.wuxing-date {
  font-size: 24rpx;
  color: #A89F91;
}

/* 章节标题 */
.section-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.section-number {
  display: inline-block;
  background: linear-gradient(135deg, #D4C4A0 0%, #B8A88A 100%);
  color: white;
  font-size: 24rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.section-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #5C4B3A;
}

/* 色系推荐 */
.color-guide-section {
  padding: 32rpx;
  background: white;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(139, 115, 85, 0.08);
  border: 1rpx solid rgba(221, 196, 143, 0.2);
}

.color-guide {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.color-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.color-item.first-choice {
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.08) 0%, rgba(255, 107, 107, 0.03) 100%);
  border-left: 6rpx solid #FF6B6B;
}

.color-item.secondary-choice {
  background: linear-gradient(135deg, rgba(76, 175, 80, 0.08) 0%, rgba(76, 175, 80, 0.03) 100%);
  border-left: 6rpx solid #4CAF50;
}

.color-item.normal-choice {
  background: linear-gradient(135deg, rgba(232, 232, 232, 0.08) 0%, rgba(232, 232, 232, 0.03) 100%);
  border-left: 6rpx solid #E8E8E8;
}

.color-item.not-recommended {
  background: linear-gradient(135deg, rgba(74, 85, 104, 0.08) 0%, rgba(74, 85, 104, 0.03) 100%);
  border-left: 6rpx solid #4A5568;
}

.color-item.strongly-not-recommended {
  background: linear-gradient(135deg, rgba(246, 224, 94, 0.08) 0%, rgba(246, 224, 94, 0.03) 100%);
  border-left: 6rpx solid #F6E05E;
}

.color-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tshirt {
  font-size: 40rpx;
}

.color-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.color-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #5C4B3A;
}

.color-desc {
  font-size: 26rpx;
  color: #8B7355;
  line-height: 1.5;
}

/* 视觉维度分析 */
.wuxing-analysis-section {
  padding: 32rpx;
  background: white;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(139, 115, 85, 0.08);
  border: 1rpx solid rgba(221, 196, 143, 0.2);
}

.radar-container {
  margin: 32rpx 0;
  display: flex;
  justify-content: center;
}

.aesthetics-summary {
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(46, 88, 235, 0.05) 0%, rgba(46, 88, 235, 0.02) 100%);
  border-radius: 16rpx;
  border-left: 4rpx solid #2E58EB;
}

.summary-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: #475569;
}

/* 色彩美学解析 */
.wuxing-interpretation-section {
  margin-top: 32rpx;
  margin-bottom: 32rpx;
}

.interpretation-card {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(139, 115, 85, 0.08);
  border: 1rpx solid rgba(221, 196, 143, 0.2);
}

.interpretation-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.interpretation-text {
  font-size: 28rpx;
  line-height: 2;
  color: #475569;
  text-align: justify;
  letter-spacing: 0.5rpx;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  justify-content: center;
  padding: 32rpx;
}

.regenerate-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 64rpx;
  background: linear-gradient(135deg, #2E58EB 0%, #1E40AF 100%);
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 32rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(46, 88, 235, 0.3);
}

.btn-icon {
  font-size: 36rpx;
}

.btn-text {
  white-space: nowrap;
}
