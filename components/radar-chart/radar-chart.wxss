.radar-chart-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 20rpx 0;
}

.radar-canvas {
  width: 400rpx;
  height: 400rpx;
}

.summary-text {
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748B;
  text-align: center;
  padding: 0 30rpx;
  width: 100%;
  box-sizing: border-box;
}
