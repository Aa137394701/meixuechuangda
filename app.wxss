/* 全局样式 - Qingyu Future Edition */

page {
  --brand-blue: #2E58EB;
  --bg-gradient: linear-gradient(180deg, #F0F4FF 0%, #FFFFFF 100%);
  --glass-white: rgba(255, 255, 255, 0.7);
  --glass-border: rgba(255, 255, 255, 0.5);
  --card-shadow: 0 8px 30px rgba(46, 88, 235, 0.08);
  --text-primary: #1D1D1F;
  --text-secondary: #6E6E73;
  --accent-glow: rgba(46, 88, 235, 0.2);
  
  background-color: #F5F7FA;
  font-family: -apple-system, "SF Pro SC", "SF Pro Display", "PingFang SC", "Helvetica Neue", sans-serif;
}

.container {
  padding: 0;
}
